{
  "schema_version": 1,
  "experiment_id": "development-format-pilot-v1",
  "task_manifest": "full_benchmark.json",
  "task_ids": [
    "full-v1-reasoning-development-01",
    "full-v1-reasoning-development-02",
    "full-v1-evidence-development-01",
    "full-v1-evidence-development-02",
    "full-v1-algebra-development-01",
    "full-v1-algebra-development-02",
    "full-v1-units-development-01",
    "full-v1-units-development-02"
  ],
  "protocol": {
    "model": "llama3.2:3b",
    "num_agents": 10,
    "round": 0,
    "temperature": 0.7,
    "max_tokens": 1024,
    "context_tokens": 16384,
    "keep_alive": 0,
    "transport": "nonstreaming_local_ollama",
    "execution_mode": "sequential_alternating_pairs",
    "pair_order": "baseline_first_when_question_index_plus_agent_id_is_even",
    "seed_policy": "agent_seed(question_id,0,agent_id)",
    "prompt_policy": "unchanged_baseline_SYSTEM_and_original_question",
    "scoring": "exact_rational_plurality_ties_abstain_exact_equality",
    "explanation_word_limit": 60,
    "explanation_bound_is_correctness_gate": false,
    "repairs": false,
    "technical_min_eligible": 72,
    "technical_max_calculator_errors": 4,
    "maximum_collective_accuracy_loss_questions": 1,
    "adoption_policy": "recommendation_only_new_full_protocol_requires_review"
  },
  "profiles": {
    "baseline_json": "json",
    "strict_schema": {
      "type": "object",
      "properties": {
        "explanation": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "pattern": "^[0-9.()+*/ -]{1,1000}$"
        }
      },
      "required": [
        "explanation",
        "expression"
      ],
      "additionalProperties": false
    }
  }
}
